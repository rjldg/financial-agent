# --- Telegram ---
TELEGRAM_TOKEN=your-telegram-bot-token
ALLOWED_USER_ID=your-numeric-user-id

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Model used for receipt photos. Defaults to OLLAMA_MODEL, so if your text
# model already reads images (like gemma3:4b), leave this unset and one
# model serves both text and receipts, never needing to swap.
# OLLAMA_VISION_MODEL=gemma3:4b
# Context window (tokens) given to Ollama. Default 2048 comfortably fits
# the router prompt (~600 tokens).
# OLLAMA_NUM_CTX=2048
# How long Ollama keeps the model loaded in VRAM after a reply. Default 30m
# holds ~2.9 GB of VRAM for 30 minutes after each message so the next reply
# is fast - this is intended, not a leak.
# OLLAMA_KEEP_ALIVE=30m

# --- Google Sheets ---
# Path to the service-account JSON file (relative to working dir inside container)
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
# The ID from the Google Sheet URL:  https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your-google-sheet-id

# --- Localization ---
APP_TIMEZONE=Asia/Manila
CURRENCY_CODE=PHP
CURRENCY_SYMBOL=₱

# --- Scheduling (local hours in APP_TIMEZONE) ---
WEEKLY_DIGEST_DAY=mon
WEEKLY_DIGEST_HOUR=8
SUB_CHECK_HOUR=8

# --- Budgets ---
BUDGET_ALERT_THRESHOLD=0.8

# --- Feature toggles (optional; default enabled) ---
# Set to false to disable the receipt-photo (OCR) handler entirely.
ENABLE_RECEIPT_OCR=true
